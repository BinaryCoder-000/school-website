# Public School Management System login URL (Login button destination).
# Required in production builds. No localhost fallback is used in production.
VITE_SMS_URL=http://localhost:5174

# Canonical site origin used for Open Graph URLs, canonical tags, robots.txt, and sitemap.xml.
# Example: https://www.your-school-domain.edu.in
VITE_SITE_URL=http://localhost:5173
